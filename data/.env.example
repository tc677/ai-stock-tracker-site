# Alpaca API credentials — get from https://app.alpaca.markets
# Use paper-trading keys (https://paper-api.alpaca.markets) until ready for live.
ALPACA_KEY_ID=your-key-id
ALPACA_SECRET_KEY=your-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Postgres — same as app/.env.example for local dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stockdash
