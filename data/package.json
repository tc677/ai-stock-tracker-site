{
  "name": "data",
  "version": "0.1.0",
  "private": true,
  "description": "Lambda puller: Alpaca account/positions/activity + Yahoo index data → Postgres",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --minify --external:pg-native",
    "package": "npm run build && cd dist && zip -r ../puller.zip index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
